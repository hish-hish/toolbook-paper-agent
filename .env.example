# 环境变量模板：复制为 .env 后填写真实值（cp .env.example .env）。
# .env 已 gitignore，绝不提交、绝不贴聊天；本模板不含任何真实密钥。

# 硅基流动密钥（必填）：https://cloud.siliconflow.cn 控制台 → API 密钥 获取。
# LLM 对话、向量化、云端重排共用这一个密钥。
SILICONFLOW_API_KEY=

# 应用登录账号密码（公网部署务必两项都填，否则登录门关闭＝任何人可访问）。
# 本地开发可留空两项＝关闭登录门直接可用。密码绝不硬编码进代码/镜像。
TOOLBOOK_AUTH_USER=hish
TOOLBOOK_AUTH_PASS=

# 重排后端：api=云端硅基流动 /v1/rerank（云镜像默认，免 torch）；
#           local=本地 bge-reranker 模型（需 sentence-transformers/torch，云镜像不含）。
TOOLBOOK_RERANK_BACKEND=api